# Copy this file to .env and fill in real keys before using live mode.
# Leave any of these blank to run that module in MOCK MODE (no external calls).

# --- Social profile discovery ---
# Use a legitimate search API. Do NOT scrape Google/Bing search results pages
# directly with requests/BeautifulSoup/Playwright -- that violates their
# Terms of Service. Use an official API instead:
#   Bing Web Search API: https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
#   SerpAPI (wraps Google legally via licensing): https://serpapi.com/
BING_SEARCH_API_KEY=
SERPAPI_API_KEY=

# --- Phone number lookup ---
# Use a licensed reverse-lookup provider. Do NOT use scraped/breached-data
# "people search" dumps.
#   NumVerify: https://numverify.com/
#   Twilio Lookup: https://www.twilio.com/docs/lookup
NUMVERIFY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Case metadata (for audit log) ---
INVESTIGATOR_ID=
CASE_NUMBER=
